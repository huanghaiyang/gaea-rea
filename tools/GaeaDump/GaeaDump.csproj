<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Offline managed-code analysis helper for the Gaea reverse-engineering effort.

    Motivation: nuget.org is unreachable from this sandbox, so PackageReference is
    not usable. This project instead references a complete ICSharpCode.Decompiler
    9.1.0 (netstandard2.0) that ships inside the local Trae C# extension, plus its
    runtime dependencies. dnSpy's own 510 KB ICSharpCode.Decompiler.dll is a
    trimmed build without the CSharpDecompiler API, so it is deliberately unused.

    Build: dotnet build tools/GaeaDump/GaeaDump.csproj -c Release
    Run:   dotnet tools/GaeaDump/bin/Release/net8.0/GaeaDump.dll <mode> <assembly> [filter]
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>GaeaDump</AssemblyName>
    <RootNamespace>GaeaDump</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RestorePackages>false</RestorePackages>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <NoWarn>$(NoWarn);CS0618;NU1701;MSB3277</NoWarn>
    <RoslynDir>C:\Users\huanh\.trae-cn\extensions\muhammad-sammy.csharp-2.145.21-g154a82fd27-win32-x64\.roslyn</RoslynDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="ICSharpCode.Decompiler">
      <HintPath>$(RoslynDir)\ICSharpCode.Decompiler.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!--
    Decompiler runtime dependencies. These are deliberately copied next to the
    built executable rather than referenced, so the compiler does not try to
    rebind framework-provided types against netstandard shims.
  -->
  <Target Name="CopyDecompilerDependencies" AfterTargets="Build">
    <ItemGroup>
      <_DecompilerDep Include="$(RoslynDir)\Microsoft.Extensions.Logging.Abstractions.dll" />
      <_DecompilerDep Include="$(RoslynDir)\Microsoft.Bcl.AsyncInterfaces.dll" />
      <_DecompilerDep Include="$(RoslynDir)\System.Reflection.Metadata.dll" />
      <_DecompilerDep Include="$(RoslynDir)\System.Collections.Immutable.dll" />
      <_DecompilerDep Include="$(RoslynDir)\Humanizer.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_DecompilerDep)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true"
          Condition="Exists('%(FullPath)')" />
    <Message Importance="high" Text="GaeaDump: copied decompiler dependencies to $(OutDir)" />
  </Target>

</Project>
