<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>DecompileProbe</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestorePackages>false</RestorePackages>
    <NoWarn>$(NoWarn);CS0618</NoWarn>
    <RoslynDir>C:\Users\huanh\.trae-cn\extensions\muhammad-sammy.csharp-2.145.21-g154a82fd27-win32-x64\.roslyn</RoslynDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="ICSharpCode.Decompiler">
      <HintPath>$(RoslynDir)\ICSharpCode.Decompiler.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <Target Name="CopyDeps" AfterTargets="Build">
    <ItemGroup>
      <_Dep Include="$(RoslynDir)\Microsoft.Extensions.Logging.Abstractions.dll" />
      <_Dep Include="$(RoslynDir)\Microsoft.Bcl.AsyncInterfaces.dll" />
      <_Dep Include="$(RoslynDir)\System.Reflection.Metadata.dll" />
      <_Dep Include="$(RoslynDir)\System.Collections.Immutable.dll" />
      <_Dep Include="$(RoslynDir)\Humanizer.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_Dep)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('%(FullPath)')" />
  </Target>
</Project>
