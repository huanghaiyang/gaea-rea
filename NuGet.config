<?xml version="1.0" encoding="utf-8"?>
<!--
  Workspace-local NuGet configuration for the Gaea REA analysis toolchain.

  The user-level NuGet.Config enables packageSourceMapping with a whitelist that
  does not include ilspycmd, so `dotnet tool install` fails there. This file
  clears the inherited sources/mapping and exposes only nuget.org, which is
  enough to install the decompiler locally under tools/ilspy.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <clear />
  </packageSourceMapping>
  <config>
    <add key="globalPackagesFolder" value="D:\sgames\gaea-rea\.nuget-packages" />
  </config>
</configuration>
